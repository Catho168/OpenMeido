<Window x:Class="OpenMeido.CustomNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Icon="{x:Null}">
    
    <Window.Resources>
        <!-- 窗口阴影效果 -->
        <DropShadowEffect x:Key="WindowShadowEffect"
                          Color="Black"
                          Direction="315"
                          ShadowDepth="8"
                          BlurRadius="15"
                          Opacity="0.4"/>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MeidoThemeColorDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标样式 -->
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- 主容器，带圆角和阴影 -->
    <Border Background="White"
            CornerRadius="12"
            Effect="{StaticResource WindowShadowEffect}"
            BorderBrush="{StaticResource MeidoThemeColor}"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 图标和标题区域 -->
                <RowDefinition Height="*"/>    <!-- 消息内容 -->
                <RowDefinition Height="Auto"/> <!-- 按钮区域 -->
            </Grid.RowDefinitions>

            <!-- 图标和标题区域 -->
            <Border Grid.Row="0"
                    Background="{StaticResource MeidoThemeColor}"
                    CornerRadius="10,10,0,0"
                    Padding="20,15">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="IconTextBlock"
                               Style="{StaticResource IconStyle}"
                               Foreground="White"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="TitleTextBlock"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 消息内容区域 -->
            <Border Grid.Row="1"
                    Padding="20,15">
                <TextBlock x:Name="MessageTextBlock"
                           FontSize="13"
                           Foreground="#374151"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="20"/>
            </Border>

            <!-- 按钮区域 -->
            <Border Grid.Row="2"
                    Padding="20,10"
                    Background="#F9FAFB">
                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <!-- 按钮将在这里动态添加 -->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>