<Window x:Class="OpenMeido.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="妹抖酱配置" Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="{x:Null}">
    
    <Window.Resources>
        <!-- 定义标签样式，统一外观 -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <!-- 定义文本框样式，统一外观 -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 定义密码框样式，统一外观 -->
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 定义下拉框样式，统一外观 -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path Grid.Column="1"
                                          Width="12" Height="8"
                                          Data="M 0 0 L 6 6 L 12 0"
                                          Stroke="#6B7280"
                                          StrokeThickness="1.5"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 定义按钮样式 -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MeidoThemeColorDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口阴影效果 -->
        <DropShadowEffect x:Key="WindowShadowEffect"
                          Color="Black"
                          Direction="315"
                          ShadowDepth="8"
                          BlurRadius="15"
                          Opacity="0.4"/>

        <!-- 标题栏按钮样式 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮特殊样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类导航按钮样式 -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MCP操作按钮统一样式 -->
        <Style x:Key="McpActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- MCP服务器列表内按钮样式 -->
        <Style x:Key="McpServerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- MCP服务器删除按钮样式 -->
        <Style x:Key="McpServerDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource McpServerButtonStyle}">
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource MeidoThemeColorDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MCP服务器列表项容器样式 -->
        <Style x:Key="McpServerListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,3,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选中的分类按钮样式 -->
        <Style x:Key="SelectedCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="#F0F8FF"/>
            <Setter Property="Foreground" Value="{StaticResource MeidoThemeColorDark}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="{StaticResource MeidoThemeColor}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E6F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器，带圆角和阴影 -->
    <Border Background="White"
            CornerRadius="12"
            Effect="{StaticResource WindowShadowEffect}"
            BorderBrush="{StaticResource MeidoThemeColor}"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- 自定义标题栏 -->
                <RowDefinition Height="*"/>   <!-- 主要内容 -->
                <RowDefinition Height="Auto"/> <!-- 按钮区域 -->
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0"
                    Background="{StaticResource MeidoThemeColor}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题文本 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                        <TextBlock Text="⚙️" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="设置妹抖酱"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 窗口控制按钮 -->
                    <Button Grid.Column="1"
                            x:Name="MinimizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化窗口~">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" />
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭设置">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </Grid>
            </Border>

            <!-- 主要内容区域 -->
            <Grid Grid.Row="1" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主要设置区域 - 两列布局 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>  <!-- 左侧分类导航 -->
                <ColumnDefinition Width="*"/>    <!-- 右侧设置内容 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧分类导航面板 -->
            <Border Grid.Column="0"
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="设置分类"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="20,0,20,15"/>

                    <!-- 通用设置分类 -->
                    <Button x:Name="GeneralCategoryButton"
                            Content="⚙️ 通用"
                            Style="{StaticResource SelectedCategoryButtonStyle}"
                            Click="CategoryButton_Click"
                            Tag="General"/>

                    <!-- 分类分隔线 -->
                    <Separator Margin="15,5,15,5" Background="#E0E0E0"/>

                    <!-- MCP设置分类 -->
                    <Button x:Name="McpCategoryButton"
                            Content="🔧 MCP"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"
                            Tag="MCP"/>
                </StackPanel>
            </Border>

            <!-- 右侧设置内容面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="15,20,15,20">
                <Grid>
                    <!-- 通用设置面板 -->
                    <StackPanel x:Name="GeneralSettingsPanel" Visibility="Visible">

                <!-- API配置卡片 -->
                <Border Background="White"
                       BorderBrush="#D1D5DB"
                       BorderThickness="1"
                       CornerRadius="6"
                       Margin="0,0,0,16">
                    <StackPanel>
                        <!-- API配置标题 -->
                        <Border Background="#F8F9FA"
                               BorderBrush="#E5E7EB"
                               BorderThickness="0,0,0,1"
                               Padding="12,8"
                               CornerRadius="6,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔗" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="API连接配置"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#374151"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- API配置内容 -->
                        <StackPanel Margin="16">
                            <!-- API基础URL设置 -->
                            <Label Content="API基础URL:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ApiBaseUrlTextBox"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="输入妹抖酱连接的API地址哦~ 例如: https://api.openai.com/v1"/>
                            <TextBlock Text="妹抖酱支持OpenAI及其兼容格式的API服务"
                                       FontSize="10" Foreground="#6B7280" Margin="0,2,0,12"/>

                            <!-- API密钥设置 -->
                            <Label Content="API密钥:" Style="{StaticResource LabelStyle}"/>
                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Style="{StaticResource PasswordBoxStyle}"
                                         ToolTip="输入你的API密钥让妹抖酱工作~"/>
                            <TextBlock Text="请好好保管API密钥，不要告诉别人哦~"
                                       FontSize="10" Foreground="#DC2626" Margin="0,2,0,12"/>

                            <!-- 模型名称设置 -->
                            <Label Content="AI模型:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ModelNameComboBox"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="输入妹抖酱使用的模型~"/>
                            <TextBlock Text="不同模型的聪明程度和费用不同哦，按需选择吧~"
                                       FontSize="10" Foreground="#6B7280" Margin="0,2,0,12"/>

                            <!-- API连接测试 -->
                            <Border Background="#F9FAFB"
                                   BorderBrush="#E5E7EB"
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="12"
                                   Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TestConnectionButton"
                                            Content="🔍 测试连接"
                                            Style="{StaticResource ButtonStyle}"
                                            Click="TestConnectionButton_Click"
                                            ToolTip="测试妹抖酱能否正常连接~"
                                            Margin="0,0,12,0"
                                            Height="36"/>
                                    <TextBlock Text="点击测试API连接是否正常"
                                               FontSize="10" Foreground="#6B7280"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI行为配置卡片 -->
                <Border Background="White"
                       BorderBrush="#D1D5DB"
                       BorderThickness="1"
                       CornerRadius="6"
                       Margin="0,0,0,16">
                    <StackPanel>
                        <!-- AI行为配置标题 -->
                        <Border Background="#F8F9FA"
                               BorderBrush="#E5E7EB"
                               BorderThickness="0,0,0,1"
                               Padding="12,8"
                               CornerRadius="6,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AI行为参数"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#374151"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- AI行为配置内容 -->
                        <StackPanel Margin="16">
                            <!-- 最大令牌数设置 -->
                            <Label Content="回复长度:" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="MaxTokensSlider"
                                    Minimum="100" Maximum="4000"
                                    Value="1000" TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,5"/>
                            <TextBlock x:Name="MaxTokensLabel"
                                       Text="1000"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#1F2937"/>
                            <TextBlock Text="控制妹抖酱回复的长度，数值越大回复越详细哦~"
                                       FontSize="10" Foreground="#6B7280" Margin="0,2,0,16"/>

                            <!-- 温度参数设置 -->
                            <Label Content="创造力:" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="TemperatureSlider"
                                    Minimum="0.0" Maximum="2.0"
                                    Value="0.7" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,5"/>
                            <TextBlock x:Name="TemperatureLabel"
                                       Text="0.7"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#1F2937"/>
                            <TextBlock Text="控制妹抖酱的创造力，0.0很严谨，2.0很有想象力"
                                       FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 系统提示词配置卡片 -->
                <Border Background="White"
                       BorderBrush="#D1D5DB"
                       BorderThickness="1"
                       CornerRadius="6"
                       Margin="0,0,0,0">
                    <StackPanel>
                        <!-- 系统提示词配置标题 -->
                        <Border Background="#F8F9FA"
                               BorderBrush="#E5E7EB"
                               BorderThickness="0,0,0,1"
                               Padding="12,8"
                               CornerRadius="6,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💭" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="系统提示词配置"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#374151"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 系统提示词配置内容 -->
                        <StackPanel Margin="16">
                            <Label Content="系统提示词:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="SystemPromptTextBox"
                                     Style="{StaticResource TextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="150"
                                     ToolTip="为妹抖酱设置系统提示词"/>
                            <TextBlock Text="系统提示词会作为对话的预设角色设定~"
                                       FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                    </StackPanel>

                    <!-- MCP设置面板 -->
                    <StackPanel x:Name="McpSettingsPanel" Visibility="Collapsed">

                <!-- MCP功能开关卡片 -->
                <Border Background="White"
                       BorderBrush="#D1D5DB"
                       BorderThickness="1"
                       CornerRadius="6"
                       Margin="0,0,0,16">
                    <StackPanel>
                        <!-- MCP功能开关标题 -->
                        <Border Background="#F8F9FA"
                               BorderBrush="#E5E7EB"
                               BorderThickness="0,0,0,1"
                               Padding="12,8"
                               CornerRadius="6,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MCP工具支持"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#374151"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- MCP功能开关内容 -->
                        <StackPanel Margin="16">
                            <CheckBox x:Name="EnableMcpCheckBox"
                                      Content="启用MCP (Model Context Protocol) 工具支持"
                                      FontSize="12"
                                      FontWeight="Medium"
                                      Foreground="#1F2937"
                                      Margin="0,0,0,8"
                                      Checked="EnableMcpCheckBox_Checked"
                                      Unchecked="EnableMcpCheckBox_Unchecked"
                                      ToolTip="启用后妹抖酱可以使用外部工具来帮助你~"/>
                            <TextBlock Text="MCP允许妹抖酱连接外部工具和服务，大大扩展她的能力哦~"
                                       FontSize="10" Foreground="#6B7280" Margin="0,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MCP服务器配置区域 -->
                <StackPanel x:Name="McpConfigPanel" Visibility="Collapsed">
                    <!-- MCP服务器配置卡片 -->
                    <Border Background="White"
                           BorderBrush="#D1D5DB"
                           BorderThickness="1"
                           CornerRadius="6"
                           Margin="0,0,0,16">
                        <StackPanel>
                            <!-- MCP服务器配置标题 -->
                            <Border Background="#F8F9FA"
                                   BorderBrush="#E5E7EB"
                                   BorderThickness="0,0,0,1"
                                   Padding="12,8"
                                   CornerRadius="6,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔧" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MCP服务器配置"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="#374151"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- MCP服务器配置内容 -->
                            <StackPanel Margin="16">

                                <!-- MCP服务器列表 -->
                                <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" Background="White">
                        <ListBox x:Name="McpServersListBox"
                                 Height="140"
                                 SelectionChanged="McpServersListBox_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource McpServerListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 使用DockPanel实现更好的布局控制 -->
                                    <DockPanel LastChildFill="True" MinHeight="50">

                                        <!-- 右侧操作按钮区域 -->
                                        <StackPanel DockPanel.Dock="Right"
                                                   Orientation="Horizontal"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0">
                                            <Button Content="编辑"
                                                    Click="EditMcpServer_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource McpServerButtonStyle}"
                                                    ToolTip="编辑服务器配置"/>
                                            <Button Content="测试"
                                                    Click="TestMcpServer_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource McpServerButtonStyle}"
                                                    ToolTip="测试服务器连接"/>
                                            <Button Content="删除"
                                                    Click="DeleteMcpServer_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource McpServerDeleteButtonStyle}"
                                                    ToolTip="删除此服务器"/>
                                        </StackPanel>

                                        <!-- 左侧状态和启用控制 -->
                                        <StackPanel DockPanel.Dock="Left"
                                                   Orientation="Horizontal"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,12,0">
                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"
                                                     Checked="McpServerEnabled_Changed"
                                                     Unchecked="McpServerEnabled_Changed"
                                                     ToolTip="启用/禁用此服务器"/>
                                        </StackPanel>

                                        <!-- 中间服务器信息区域 -->
                                        <StackPanel VerticalAlignment="Center" Margin="0,2">
                                            <!-- 服务器名称 -->
                                            <TextBlock Text="{Binding Name}"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      Foreground="#1F2937"
                                                      Margin="0,0,0,2"/>

                                            <!-- 命令和参数 -->
                                            <TextBlock FontSize="10"
                                                      Foreground="#6B7280"
                                                      Margin="0,0,0,2"
                                                      TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Command}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Arguments}"/>
                                            </TextBlock>

                                            <!-- 描述 -->
                                            <TextBlock Text="{Binding Description}"
                                                      FontSize="9"
                                                      Foreground="#9CA3AF"
                                                      TextTrimming="CharacterEllipsis"
                                                      TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 添加新服务器按钮和示例按钮 -->
                    <Border Background="#FAFBFC"
                           BorderBrush="#E5E7EB"
                           BorderThickness="1"
                           CornerRadius="6"
                           Padding="12"
                           Margin="0,8,0,12">
                        <StackPanel>
                            <TextBlock Text="添加新的MCP服务器"
                                      FontSize="11"
                                      FontWeight="Medium"
                                      Foreground="#6B7280"
                                      Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddMcpServerButton"
                                        Content="➕ 添加服务器"
                                        Style="{StaticResource McpActionButtonStyle}"
                                        Click="AddMcpServerButton_Click"
                                        ToolTip="添加新的MCP服务器配置"/>

                                <Button x:Name="AddExampleServerButton"
                                        Content="📋 示例配置"
                                        Style="{StaticResource McpActionButtonStyle}"
                                        Background="{StaticResource MeidoThemeColorLight}"
                                        Click="AddExampleServerButton_Click"
                                        ToolTip="添加常用的MCP服务器示例配置"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>


                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 按钮区域 -->
        <Border Grid.Row="1"
               Background="#F9FAFB"
               BorderBrush="#E5E7EB"
               BorderThickness="0,1,0,0"
               Padding="20,16"
               Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource ButtonStyle}"
                        Background="{StaticResource MeidoThemeColorLight}"
                        Margin="0,0,12,0"
                        Height="36"
                        Click="CancelButton_Click"
                        ToolTip="不保存就关闭"/>

                <Button x:Name="SaveButton"
                        Content="💾 保存设置"
                        Style="{StaticResource ButtonStyle}"
                        Height="36"
                        Click="SaveButton_Click"
                        ToolTip="保存妹抖酱的设置"/>
            </StackPanel>
        </Border>

        </Grid>

        </Grid>
    </Border>
</Window>
