<Window x:Class="OpenMeido.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="妹抖酱配置"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="{x:Null}">

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsDangerBrush" Color="#D46A78"/>
        <SolidColorBrush x:Key="SettingsDangerSoftBrush" Color="#FFF4F6"/>
        <SolidColorBrush x:Key="SettingsTitleBarOverlayBrush" Color="#33FFFFFF"/>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="#FFFEFE"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ThemePrimaryLightBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemePrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ThemeRadiusMedium}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ThemeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ThemePrimaryBrush}"/>
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="#FFFEFE"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemePrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ThemeRadiusMedium}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ThemeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ThemePrimaryBrush}"/>
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="#FFFEFE"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ThemePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ThemeRadiusMedium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ThemePrimaryLightBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ThemePrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ThemePrimaryDarkBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ThemePrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderStrongBrush}"/>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ThemeRadiusMedium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder" Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="#FFF8F8"/>
            <Setter Property="Foreground" Value="{StaticResource ThemePrimaryDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ThemeRadiusMedium}"
                                Padding="{TemplateBinding Padding}">
                            <Border BorderBrush="{StaticResource ThemePrimaryBrush}"
                                    BorderThickness="3,0,0,0"
                                    CornerRadius="{StaticResource ThemeRadiusMedium}">
                                <ContentPresenter Margin="12,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder" Property="Background" Value="#FFF3F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="McpActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinWidth" Value="136"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="McpServerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="McpServerDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource McpServerButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SettingsDangerBrush}"/>
            <Setter Property="Background" Value="{StaticResource SettingsDangerSoftBrush}"/>
            <Setter Property="BorderBrush" Value="#F1C7D0"/>
        </Style>

        <Style x:Key="McpServerListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#FFFEFE"
                                BorderBrush="{StaticResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ThemeRadiusMedium}"
                                Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ThemeSurfaceSoftBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ThemeBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF8F8"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ThemePrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFEFE"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource ThemeRadiusLarge}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Border Background="{StaticResource ThemeSurfaceBrush}"
                BorderBrush="{StaticResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                RenderOptions.ClearTypeHint="Enabled"
                Effect="{StaticResource ThemeShadowLarge}">
            <Grid UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="18,18,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource ThemePrimaryColor}" Offset="0"/>
                            <GradientStop Color="{StaticResource ThemePrimaryLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="20,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,12,0"
                                    Background="#26FFFFFF"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="17">
                                <TextBlock Text="⚙"
                                           FontSize="15"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="设置妹抖酱"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="管理 API、对话风格和 MCP 扩展能力"
                                           FontSize="11"
                                           Foreground="#FDF2F2"
                                           Opacity="0.95"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="MinimizeButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource SettingsTitleBarButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="最小化窗口~">
                            <TextBlock Text="&#xE921;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"/>
                        </Button>

                        <Button Grid.Column="2"
                                x:Name="CloseButton"
                                Style="{StaticResource SettingsCloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="关闭设置">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource ThemeSurfaceSoftBrush}"
                            BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,18,0,0">
                                <Button x:Name="GeneralCategoryButton"
                                        Content="⚙️  通用设置"
                                        Style="{StaticResource SelectedCategoryButtonStyle}"
                                        Click="CategoryButton_Click"
                                        Tag="General"/>

                                <Button x:Name="McpCategoryButton"
                                        Margin="0,10,0,0"
                                        Content="🔧  MCP 工具"
                                        Style="{StaticResource CategoryButtonStyle}"
                                        Click="CategoryButton_Click"
                                        Tag="MCP"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="24">
                            <StackPanel x:Name="GeneralSettingsPanel" Visibility="Visible">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFBFB" Offset="0"/>
                                            <GradientStop Color="{StaticResource ThemeSurfaceAltColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="欢迎调整妹抖酱的对话体验"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                            <TextBlock Text="从连接配置、回复参数到系统提示词，统一使用更轻盈的卡片布局。"
                                                       Style="{StaticResource HintTextStyle}"
                                                       Margin="0,8,0,0"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Border Margin="0,0,10,0"
                                                        Padding="10,5"
                                                        Background="#FFFFFFFF"
                                                        BorderBrush="{StaticResource ThemeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                    <TextBlock Text="API 连接"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ThemePrimaryDarkBrush}"/>
                                                </Border>
                                                <Border Margin="0,0,10,0"
                                                        Padding="10,5"
                                                        Background="#FFFFFFFF"
                                                        BorderBrush="{StaticResource ThemeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                    <TextBlock Text="回复参数"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                                </Border>
                                                <Border Padding="10,5"
                                                        Background="#FFFFFFFF"
                                                        BorderBrush="{StaticResource ThemeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                    <TextBlock Text="系统提示词"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Width="88"
                                                Height="88"
                                                Margin="20,0,0,0"
                                                Background="#22FFFFFF"
                                                BorderBrush="#30FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="44"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="✨"
                                                       FontSize="32"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="API 连接配置" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="配置服务地址、模型名称与访问凭证，先确保妹抖酱能稳定连接。"
                                                   Style="{StaticResource HintTextStyle}"/>

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                <Label Content="API 基础 URL" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="ApiBaseUrlTextBox"
                                                         Style="{StaticResource TextBoxStyle}"
                                                         Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="输入妹抖酱连接的 API 地址哦~ 例如: https://api.openai.com/v1"/>
                                                <TextBlock Text="支持 OpenAI 及兼容格式接口，建议填写完整版本路径。"
                                                           Style="{StaticResource HintTextStyle}"/>

                                                <Label Content="API 密钥" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                                             Style="{StaticResource PasswordBoxStyle}"
                                                             PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                                             ToolTip="输入你的 API 密钥让妹抖酱工作~"/>
                                                <TextBlock Text="请妥善保管密钥，避免将其暴露在截图或共享日志中。"
                                                           Style="{StaticResource HintTextStyle}"
                                                           Foreground="{StaticResource SettingsDangerBrush}"/>

                                                <Label Content="模型名称" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                                                <TextBox x:Name="ModelNameComboBox"
                                                         Style="{StaticResource TextBoxStyle}"
                                                         Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="输入妹抖酱使用的模型~"/>
                                                <TextBlock Text="根据速度、成本和能力选择合适模型，例如更高推理能力或更低延迟。"
                                                           Style="{StaticResource HintTextStyle}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Padding="16"
                                                    Background="{StaticResource ThemeSurfaceSoftBrush}"
                                                    BorderBrush="{StaticResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ThemeRadiusLarge}">
                                                <StackPanel>
                                                    <TextBlock Text="连接检查"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                                    <TextBlock Text="保存前先快速验证 API 信息是否可用，避免后续聊天失败。"
                                                               Style="{StaticResource HintTextStyle}"/>

                                                    <Button x:Name="TestConnectionButton"
                                                            Margin="0,18,0,0"
                                                            Height="40"
                                                            Content="测试连接"
                                                            Style="{StaticResource ButtonStyle}"
                                                            Click="TestConnectionButton_Click"
                                                            ToolTip="测试妹抖酱能否正常连接~"/>

                                                    <Border Margin="0,16,0,0"
                                                            Padding="12"
                                                            Background="#FFFFFFFF"
                                                            BorderBrush="{StaticResource ThemeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource ThemeRadiusMedium}">
                                                        <StackPanel>
                                                            <TextBlock Text="建议检查项"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                                            <TextBlock Text="• URL 是否含 /v1\n• 密钥是否有效\n• 模型名称是否与供应商匹配"
                                                                       Style="{StaticResource HintTextStyle}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="AI 行为参数" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="调整回复长度与创造力，在稳定性和表现力之间找到更合适的平衡。"
                                                   Style="{StaticResource HintTextStyle}"/>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Margin="0,0,10,0"
                                                    Padding="16"
                                                    Background="{StaticResource ThemeSurfaceSoftBrush}"
                                                    BorderBrush="{StaticResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ThemeRadiusLarge}">
                                                <StackPanel>
                                                    <Label Content="回复长度" Style="{StaticResource LabelStyle}"/>
                                                    <Slider x:Name="MaxTokensSlider"
                                                            Minimum="100"
                                                            Maximum="4000"
                                                            Value="{Binding MaxTokens, Mode=TwoWay}"
                                                            TickFrequency="100"
                                                            IsSnapToTickEnabled="True"
                                                            Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="MaxTokensLabel"
                                                               Margin="0,10,0,0"
                                                               Text="1000"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               Foreground="{StaticResource ThemePrimaryDarkBrush}"/>
                                                    <TextBlock Text="更高数值意味着更长回复，适合复杂解释或步骤型回答。"
                                                               Style="{StaticResource HintTextStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Padding="16"
                                                    Background="{StaticResource ThemeSurfaceSoftBrush}"
                                                    BorderBrush="{StaticResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ThemeRadiusLarge}">
                                                <StackPanel>
                                                    <Label Content="创造力" Style="{StaticResource LabelStyle}"/>
                                                    <Slider x:Name="TemperatureSlider"
                                                            Minimum="0.0"
                                                            Maximum="2.0"
                                                            Value="{Binding Temperature, Mode=TwoWay}"
                                                            TickFrequency="0.1"
                                                            IsSnapToTickEnabled="True"
                                                            Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="TemperatureLabel"
                                                               Margin="0,10,0,0"
                                                               Text="0.7"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               Foreground="{StaticResource ThemePrimaryDarkBrush}"/>
                                                    <TextBlock Text="较低温度更稳定严谨，较高温度更灵活更有想象力。"
                                                               Style="{StaticResource HintTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="系统提示词配置" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="为妹抖酱补充角色设定、行为边界或回复偏好，作为整个会话的全局预设。"
                                                   Style="{StaticResource HintTextStyle}"/>

                                        <Label Content="系统提示词" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                                        <TextBox x:Name="SystemPromptTextBox"
                                                 Height="180"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource TextBoxStyle}"
                                                 Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="为妹抖酱设置系统提示词"/>
                                        <TextBlock Text="建议写清语气、能力边界、回复结构偏好，以及你希望长期遵循的规则。"
                                                   Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="McpSettingsPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFBFB" Offset="0"/>
                                            <GradientStop Color="{StaticResource ThemeSurfaceAltColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="扩展妹抖酱的工具能力"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                            <TextBlock Text="MCP 可以让妹抖酱访问外部工具与服务，例如文件系统、搜索或数据库。"
                                                       Style="{StaticResource HintTextStyle}"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Width="88"
                                                Height="88"
                                                Margin="20,0,0,0"
                                                Background="#22FFFFFF"
                                                BorderBrush="#30FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="44"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="🛠"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="MCP 工具支持" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="启用后，妹抖酱可以在对话中安全调用已配置的外部工具。"
                                                   Style="{StaticResource HintTextStyle}"/>

                                        <Border Margin="0,18,0,0"
                                                Padding="16"
                                                Background="{StaticResource ThemeSurfaceSoftBrush}"
                                                BorderBrush="{StaticResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ThemeRadiusLarge}">
                                            <StackPanel>
                                                <CheckBox x:Name="EnableMcpCheckBox"
                                                          Content="启用 MCP (Model Context Protocol) 工具支持"
                                                          IsChecked="{Binding EnableMcp, Mode=TwoWay}"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource ThemeTextPrimaryBrush}"
                                                          Checked="EnableMcpCheckBox_Checked"
                                                          Unchecked="EnableMcpCheckBox_Unchecked"
                                                          ToolTip="启用后妹抖酱可以使用外部工具来帮助你~"/>
                                                <TextBlock Text="建议只启用你确实需要的服务器，并在新增前确认命令来源可信。"
                                                           Style="{StaticResource HintTextStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="McpConfigPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="MCP 服务器配置" Style="{StaticResource SectionTitleTextStyle}"/>
                                                    <TextBlock Text="维护妹抖酱可调用的工具列表，支持启用、测试、编辑和删除。"
                                                               Style="{StaticResource HintTextStyle}"/>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Padding="10,6"
                                                        Background="{StaticResource ThemeSurfaceAltBrush}"
                                                        BorderBrush="{StaticResource ThemeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="安全优先"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ThemePrimaryDarkBrush}"/>
                                                </Border>
                                            </Grid>

                                            <Border Margin="0,18,0,16"
                                                    Background="{StaticResource ThemeSurfaceSoftBrush}"
                                                    BorderBrush="{StaticResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ThemeRadiusLarge}"
                                                    Padding="14">
                                                <ListBox x:Name="McpServersListBox"
                                                         ItemsSource="{Binding McpServers}"
                                                         Height="250"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         SelectionChanged="McpServersListBox_SelectionChanged"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ItemContainerStyle="{StaticResource McpServerListItemStyle}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel LastChildFill="True">
                                                                <StackPanel DockPanel.Dock="Right"
                                                                            Orientation="Horizontal"
                                                                            VerticalAlignment="Top"
                                                                            Margin="12,0,0,0">
                                                                    <Button Content="编辑"
                                                                            Click="EditMcpServer_Click"
                                                                            Tag="{Binding}"
                                                                            Style="{StaticResource McpServerButtonStyle}"
                                                                            ToolTip="编辑服务器配置"/>
                                                                    <Button Content="测试"
                                                                            Click="TestMcpServer_Click"
                                                                            Tag="{Binding}"
                                                                            Style="{StaticResource McpServerButtonStyle}"
                                                                            ToolTip="测试服务器连接"/>
                                                                    <Button Content="删除"
                                                                            Click="DeleteMcpServer_Click"
                                                                            Tag="{Binding}"
                                                                            Style="{StaticResource McpServerDeleteButtonStyle}"
                                                                            ToolTip="删除此服务器"/>
                                                                </StackPanel>

                                                                <StackPanel DockPanel.Dock="Left"
                                                                            Orientation="Horizontal"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,2,12,0">
                                                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                                                              VerticalAlignment="Center"
                                                                              Checked="McpServerEnabled_Changed"
                                                                              Unchecked="McpServerEnabled_Changed"
                                                                              ToolTip="启用/禁用此服务器"/>
                                                                </StackPanel>

                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource ThemeTextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Command}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding Arguments}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Description}"
                                                                               Margin="0,6,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource ThemeTextMutedBrush}"
                                                                               TextWrapping="Wrap"
                                                                               MaxHeight="34"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>

                                            <Border Padding="16"
                                                    Background="{StaticResource ThemeSurfaceAltBrush}"
                                                    BorderBrush="{StaticResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ThemeRadiusLarge}">
                                                <StackPanel>
                                                    <TextBlock Text="快速新增服务器"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
                                                    <TextBlock Text="你可以手动添加，也可以从示例模板开始，再按需求修改命令和参数。"
                                                               Style="{StaticResource HintTextStyle}"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                        <Button x:Name="AddMcpServerButton"
                                                                Content="添加服务器"
                                                                Style="{StaticResource McpActionButtonStyle}"
                                                                Click="AddMcpServerButton_Click"
                                                                ToolTip="添加新的 MCP 服务器配置"/>

                                                        <Button x:Name="AddExampleServerButton"
                                                                Content="示例配置"
                                                                Style="{StaticResource McpActionButtonStyle}"
                                                                Background="{StaticResource ThemePrimaryLightBrush}"
                                                                BorderBrush="{StaticResource ThemePrimaryLightBrush}"
                                                                Click="AddExampleServerButton_Click"
                                                                ToolTip="添加常用的 MCP 服务器示例配置"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource ThemeSurfaceSoftBrush}"
                        BorderBrush="{StaticResource ThemeBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,18,18"
                        Padding="24,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Width="108"
                                Height="40"
                                Margin="0,0,12,0"
                                Content="取消"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"
                                ToolTip="不保存就关闭"/>

                        <Button x:Name="SaveButton"
                                Width="132"
                                Height="40"
                                Content="保存设置"
                                Style="{StaticResource ButtonStyle}"
                                Click="SaveButton_Click"
                                ToolTip="保存妹抖酱的设置"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>