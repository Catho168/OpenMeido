<Window x:Class="OpenMeido.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="300" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01FFFFFF"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="True">
    <Canvas x:Name="MainCanvas" Background="Transparent" IsHitTestVisible="True">
        <!-- 女仆图片，位于圆盘中心 -->
        <Image x:Name="MeidoImage"
               Source="Assets/Meido/Meido_standby.png"
               Width="83"
               Height="83"
               Style="{StaticResource MeidoImageStyle}"
               Canvas.Left="110" Canvas.Top="110"/>

        <!-- MCP状态指示器 -->
        <Border x:Name="McpStatusIndicator"
                Background="#E0FFFFFF"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="5,2"
                Canvas.Left="10" Canvas.Top="10"
                Visibility="Collapsed"
                ToolTip="MCP服务器状态">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="McpStatusDot"
                         Width="8" Height="8"
                         Fill="Gray"
                         VerticalAlignment="Center"
                         Margin="0,0,5,0"/>
                <TextBlock x:Name="McpStatusText"
                           Text="{Binding McpStatusText}"
                           FontSize="10"
                           Foreground="#333"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
