<Window x:Class="OpenMeido.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenMeido.Controls"
        Title="{Binding WindowTitle}" Height="300" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01FFFFFF"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="True">
    <Canvas x:Name="MainCanvas" Background="Transparent" IsHitTestVisible="True">
        <!-- 女仆图片，位于圆盘中心 -->
        <Image x:Name="MeidoImage"
               Source="Assets/Meido/Meido_standby.png"
               Width="83"
               Height="83"
               Style="{StaticResource MeidoImageStyle}"
               Canvas.Left="110" Canvas.Top="110"/>

        <!-- MCP状态指示器 -->
        <Border x:Name="McpStatusIndicator"
                Background="#E0FFFFFF"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="5,2"
                Canvas.Left="10" Canvas.Top="10"
                Visibility="{Binding McpStatusVisibility}"
                ToolTip="{Binding McpStatusToolTip}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="McpStatusDot"
                         Width="8" Height="8"
                         Fill="{Binding McpStatusDotBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,5,0"/>
                <TextBlock x:Name="McpStatusText"
                           Text="{Binding McpStatusText}"
                           FontSize="10"
                           Foreground="#333"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Popup x:Name="MiniChatPopup"
               AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=MainCanvas}"
               Placement="Relative"
               StaysOpen="True">
            <controls:MiniChatControl x:Name="MiniChatControl"
                                      DataContext="{Binding DataContext.MiniChat, ElementName=RootWindow}"/>
        </Popup>
    </Canvas>
</Window>
