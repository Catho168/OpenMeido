<UserControl x:Class="OpenMeido.Controls.ChatHistoryPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="HistoryPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HistoryButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HistoryButtonBorder" Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HistoryButtonBorder" Property="Background" Value="{StaticResource MeidoThemeColorDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="HistoryPanelBorder"
            Background="#FFF7F7"
            BorderBrush="#F1E1E4"
            BorderThickness="0,0,0,1"
            Height="0"
            ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="16,14">
            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="📚 聊天历史"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#5B4952"/>
                    <TextBlock Text="快速回到之前的对话上下文"
                               FontSize="11"
                               Foreground="#8B7680"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="NewChatButton"
                        Content="➕ 新建对话"
                        Style="{StaticResource HistoryPrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="NewChatButton_Click"
                        ToolTip="开始新的对话"/>

                <StackPanel x:Name="HistoryItemsPanel" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>