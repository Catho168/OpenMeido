<UserControl x:Class="OpenMeido.Controls.ChatMessageListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="ChatMessageTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}"/>
        </Style>

        <DataTemplate x:Key="UserMessageTemplate">
            <StackPanel HorizontalAlignment="Right" Margin="70,8,6,8">
                <TextBlock Text="你"
                           FontSize="10"
                           Foreground="#A78F98"
                           HorizontalAlignment="Right"
                           Margin="0,0,6,4"/>
                <Border Background="{StaticResource MeidoThemeColor}"
                        CornerRadius="18,18,6,18"
                        Padding="16,12"
                        MaxWidth="520">
                    <TextBlock Text="{Binding DisplayText}"
                               Style="{StaticResource ChatMessageTextStyle}"
                               Foreground="White"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate">
            <StackPanel HorizontalAlignment="Left" Margin="6,8,70,8">
                <TextBlock Text="妹抖酱"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#A56B72"
                           Margin="8,0,0,4"/>
                <Border Background="White"
                        BorderBrush="#ECDDE1"
                        BorderThickness="1"
                        CornerRadius="18,18,18,6"
                        Padding="16,12"
                        MaxWidth="560">
                    <Border.Effect>
                        <DropShadowEffect Color="#18000000" BlurRadius="10" ShadowDepth="2" Opacity="0.16"/>
                    </Border.Effect>
                    <TextBlock Text="{Binding DisplayText}"
                               Style="{StaticResource ChatMessageTextStyle}"
                               Foreground="#3A2E34"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WelcomeMessageTemplate">
            <Border Background="#FFF4F4"
                    BorderBrush="#EBCED0"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18,16"
                    Margin="6,20,90,12"
                    HorizontalAlignment="Left"
                    MaxWidth="580">
                <StackPanel>
                    <TextBlock Text="欢迎回来 ✨"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#A55D66"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DisplayText}"
                               Style="{StaticResource ChatMessageTextStyle}"
                               Foreground="#4B3B42"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolCallMessageTemplate">
            <Border Background="Transparent"
                    Margin="0,10"
                    HorizontalAlignment="Center">
                <Button Command="{Binding ShowDetailsCommand}"
                        IsEnabled="{Binding CanShowDetails}"
                        ToolTip="{Binding ToolCallToolTip}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Focusable="False"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ToolCallBorder"
                                                Background="#FFF6E8"
                                                BorderBrush="#F1D7AA"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14,12"
                                                HorizontalAlignment="Center"
                                                MaxWidth="360">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="🔧 工具调用"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#A8741D"
                                                               DockPanel.Dock="Left"/>
                                                    <TextBlock x:Name="DetailsHint"
                                                               Text="查看详情"
                                                               FontSize="10"
                                                               Foreground="#C38B30"
                                                               HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding ToolName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#6C4A15"
                                                           TextAlignment="Center"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontSize="11"
                                                           Foreground="#86673C"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontFamily="{StaticResource GlobalFontFamily}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToolCallBorder" Property="Background" Value="#FFF0D8"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter TargetName="ToolCallBorder" Property="Opacity" Value="0.86"/>
                                                <Setter TargetName="DetailsHint" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="MessageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="#FFFBFB">
        <ItemsControl x:Name="MessagesItemsControl"
                      Margin="18,16"
                      ItemsSource="{Binding DisplayMessages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource AssistantMessageTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource UserMessageTemplate}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWelcome}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource WelcomeMessageTemplate}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToolCall}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ToolCallMessageTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>