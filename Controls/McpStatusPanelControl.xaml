<UserControl x:Class="OpenMeido.Controls.McpStatusPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="McpOutlineButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8C4C5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5861"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="McpButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="McpButtonBorder" Property="Background" Value="#FFF0F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="McpButtonBorder" Property="Background" Value="#FFE7E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="McpStatusPanelBorder"
            Background="#FFF8F4"
            BorderBrush="#F1E1E4"
            BorderThickness="0,0,0,1"
            Height="0"
            ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="16,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="🔧 MCP 工具状态"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#5B4952"/>
                        <TextBlock Text="服务器、可用工具和最近活动一览"
                                   FontSize="11"
                                   Foreground="#8A777F"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="RefreshMcpButton"
                            Content="刷新"
                            Style="{StaticResource McpOutlineButtonStyle}"
                            Click="RefreshMcpButton_Click"
                            ToolTip="刷新MCP状态"/>
                </DockPanel>

                <Border Background="White"
                        BorderBrush="#ECDDE1"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="服务器状态"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B5861"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="McpServersPanel"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#ECDDE1"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📋 可用工具"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B5861"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="McpToolsPanel"/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="📊 活动日志"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6B5861"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <Button x:Name="ClearMcpLogButton"
                            Content="清空"
                            Style="{StaticResource McpOutlineButtonStyle}"
                            Click="ClearMcpLogButton_Click"
                            ToolTip="清空MCP活动日志"/>
                </DockPanel>
                <Border Background="White"
                        BorderBrush="#ECDDE1"
                        BorderThickness="1"
                        CornerRadius="14"
                        MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <StackPanel x:Name="McpActivityPanel"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>