<UserControl x:Class="OpenMeido.Controls.ChatToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ToolbarSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FFF8F8"/>
            <Setter Property="BorderBrush" Value="#E8C4C5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5861"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolbarSecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolbarSecondaryBorder" Property="Background" Value="#FFF0F1"/>
                                <Setter TargetName="ToolbarSecondaryBorder" Property="BorderBrush" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolbarSecondaryBorder" Property="Background" Value="#FFE7E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarSecondaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#FFF8F8"
            BorderBrush="#F1E1E4"
            BorderThickness="0,0,0,1">
        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#F1E1E4"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,8">
                <Button x:Name="HistoryToggleButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Click="HistoryToggleButton_Click"
                        ToolTip="展开/折叠历史记录">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HistoryToggleIconElement"
                                   Text="📁"
                                   FontSize="14"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentSessionTitleElement"
                                   Text="{Binding CurrentSessionTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#5B4952"/>
                    </StackPanel>
                </Button>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="McpStatusButton"
                        Content="MCP状态"
                        Style="{StaticResource ToolbarSecondaryButtonStyle}"
                        Click="McpStatusButton_Click"
                        ToolTip="查看MCP服务器和工具状态"/>

                <Button x:Name="ClearButton"
                        Content="清空对话"
                        Style="{StaticResource ToolbarSecondaryButtonStyle}"
                        Click="ClearButton_Click"
                        ToolTip="清空所有对话记录"/>

                <Button x:Name="SettingsButton"
                        Content="设置"
                        Style="{StaticResource ToolbarPrimaryButtonStyle}"
                        Click="SettingsButton_Click"
                        ToolTip="打开AI助手设置"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>