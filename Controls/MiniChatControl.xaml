<UserControl x:Class="OpenMeido.Controls.MiniChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Height="280"
             MinWidth="220">
    <UserControl.Resources>
        <DataTemplate x:Key="MiniChatUserMessageTemplate">
            <StackPanel HorizontalAlignment="Right" Margin="44,3,0,3">
                <Border Background="{StaticResource MeidoThemeColor}"
                        CornerRadius="12,12,4,12"
                        Padding="8,6"
                        HorizontalAlignment="Right"
                        MaxWidth="176">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="11"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MiniChatAssistantMessageTemplate">
            <StackPanel HorizontalAlignment="Left" Margin="0,3,44,3">
                <Border Background="#FFF8F8"
                        BorderBrush="#ECDDE1"
                        BorderThickness="1"
                        CornerRadius="12,12,12,4"
                        Padding="8,6"
                        HorizontalAlignment="Left"
                        MaxWidth="176">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="11"
                               Foreground="#3A2E34"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MiniChatToolCallTemplate">
            <Border Background="Transparent"
                    Margin="0,4"
                    HorizontalAlignment="Center">
                <Border Background="#FFF6E8"
                        BorderBrush="#F1D7AA"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,6"
                        MaxWidth="160">
                    <StackPanel>
                        <TextBlock Text="工具调用"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#A8741D"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding DisplayText}"
                                   FontSize="10"
                                   Foreground="#7A5D32"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <Style x:Key="MiniChatSendButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniChatSendBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniChatSendBorder" Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniChatSendBorder" Property="Background" Value="{StaticResource MeidoThemeColorDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MiniChatSendBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="{StaticResource MeidoThemeColor}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFF4F4"
                    BorderBrush="#ECDDE1"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="迷你聊天"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#5B4952"/>
                    <TextBlock Text="连续 3 轮后将自动升级到窗口对话"
                               FontSize="10"
                               Foreground="#8A777F"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="12,10,12,8">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource MiniChatAssistantMessageTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource MiniChatUserMessageTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToolCall}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource MiniChatToolCallTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputTextBox"
                         Grid.Column="0"
                         MinWidth="140"
                         Height="34"
                         Margin="0,0,8,0"
                         FontSize="12"
                         Style="{StaticResource MiniChatTextBoxStyle}"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsInputEnabled}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="发送"
                        Style="{StaticResource MiniChatSendButtonStyle}"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding CanSend}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>