<UserControl x:Class="OpenMeido.Controls.MiniChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="140">
    <UserControl.Resources>
        <DataTemplate x:Key="MiniChatUserMessageTemplate">
            <Border Background="{StaticResource MeidoThemeColor}"
                    CornerRadius="10"
                    Padding="6,4,6,4"
                    Margin="40,2,0,2"
                    HorizontalAlignment="Right"
                    MaxWidth="180">
                <TextBlock Text="{Binding DisplayText}"
                           FontSize="11"
                           Foreground="White"
                           TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MiniChatAssistantMessageTemplate">
            <Border Background="#F0F0F0"
                    CornerRadius="10"
                    Padding="6,4,6,4"
                    Margin="0,2,40,2"
                    HorizontalAlignment="Left"
                    MaxWidth="180">
                <TextBlock Text="{Binding DisplayText}"
                           FontSize="11"
                           Foreground="Black"
                           TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MiniChatToolCallTemplate">
            <Border Background="Transparent"
                    Margin="0,4,0,4"
                    HorizontalAlignment="Center">
                <Border Background="#F5F5F5"
                        BorderBrush="#DCDCDC"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,4,8,4"
                        HorizontalAlignment="Center"
                        MaxWidth="160">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="10"
                               Foreground="#666666"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0">
        <StackPanel Margin="10">
            <ItemsControl ItemsSource="{Binding Messages}"
                          Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MiniChatAssistantMessageTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource MiniChatUserMessageTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToolCall}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource MiniChatToolCallTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="InputTextBox"
                     MinWidth="140"
                     Height="26"
                     FontSize="12"
                     Style="{StaticResource MiniChatTextBoxStyle}"
                     Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsInputEnabled}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>
    </Border>
</UserControl>