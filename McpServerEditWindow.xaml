<Window x:Class="OpenMeido.McpServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP服务器配置" Height="480" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="{x:Null}">
    
    <Window.Resources>
        <!-- 定义标签样式，统一外观 -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <!-- 定义文本框样式，统一外观 -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 定义按钮样式 -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MeidoThemeColorDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口阴影效果 -->
        <DropShadowEffect x:Key="WindowShadowEffect"
                          Color="Black"
                          Direction="315"
                          ShadowDepth="8"
                          BlurRadius="15"
                          Opacity="0.4"/>

        <!-- 标题栏按钮样式 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MeidoThemeColorLight}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮特殊样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MeidoThemeColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器，带圆角和阴影 -->
    <Border Background="White"
            CornerRadius="12"
            Effect="{StaticResource WindowShadowEffect}"
            BorderBrush="{StaticResource MeidoThemeColor}"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- 自定义标题栏 -->
                <RowDefinition Height="*"/>   <!-- 主要内容 -->
                <RowDefinition Height="Auto"/> <!-- 按钮区域 -->
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0"
                    Background="{StaticResource MeidoThemeColor}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题文本 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                        <TextBlock Text="🔧" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock x:Name="WindowTitleText"
                                   Text="MCP服务器配置"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 窗口控制按钮 -->
                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭窗口">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </Grid>
            </Border>

            <!-- 主要内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- MCP服务器配置卡片 -->
                    <Border Background="White"
                           BorderBrush="#D1D5DB"
                           BorderThickness="1"
                           CornerRadius="8"
                           Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 配置表单标题 -->
                            <Border Background="#F9FAFB"
                                   BorderBrush="#E5E7EB"
                                   BorderThickness="0,0,0,1"
                                   Padding="16,12"
                                   CornerRadius="8,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FormTitleText"
                                              Text="服务器详细配置"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="#374151"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 配置表单内容 -->
                            <StackPanel Margin="16">
                                <Label Content="服务器名称 *:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ServerNameTextBox" 
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="为MCP服务器指定一个易识别的名称"/>
                                <TextBlock Text="请输入唯一的服务器名称，便于管理和识别"
                                          FontSize="10" Foreground="#6B7280" Margin="0,-8,0,8"/>

                                <Label Content="启动命令 *:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ServerCommandTextBox" 
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="输入启动MCP服务器的命令，如：node, python, npx等"/>
                                <TextBlock Text="常用命令：node、python、npx、可执行文件的完整路径"
                                          FontSize="10" Foreground="#6B7280" Margin="0,-8,0,8"/>

                                <Label Content="命令参数:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ServerArgumentsTextBox" 
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="输入传递给启动命令的参数"/>
                                <TextBlock Text="例如：server.js、-m module_name、--config config.json等"
                                          FontSize="10" Foreground="#6B7280" Margin="0,-8,0,8"/>

                                <Label Content="服务器描述:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ServerDescriptionTextBox"
                                         Style="{StaticResource TextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"
                                         ToolTip="描述这个MCP服务器的功能和用途"/>
                                <TextBlock Text="简要描述服务器的功能，帮助理解其用途"
                                          FontSize="10" Foreground="#6B7280" Margin="0,-8,0,8"/>

                                <!-- 配置示例提示 -->
                                <Border Background="#F0F9FF"
                                       BorderBrush="#BAE6FD"
                                       BorderThickness="1"
                                       CornerRadius="6"
                                       Padding="12"
                                       Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 配置示例"
                                                  FontWeight="SemiBold"
                                                  FontSize="11"
                                                  Foreground="{StaticResource MeidoThemeColorDark}"
                                                  Margin="0,0,0,6"/>
                                        <TextBlock FontSize="10" Foreground="#1F2937" TextWrapping="Wrap">
                                            <Run Text="• 文件系统访问：命令=npx，参数=-y @modelcontextprotocol/server-filesystem C:\"/>
                                            <LineBreak/>
                                            <Run Text="• Web搜索：命令=npx，参数=-y @modelcontextprotocol/server-brave-search"/>
                                            <LineBreak/>
                                            <Run Text="• SQLite数据库：命令=npx，参数=-y @modelcontextprotocol/server-sqlite path/to/db.db"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮区域 -->
            <Border Grid.Row="2"
                   Background="#F9FAFB"
                   BorderBrush="#E5E7EB"
                   BorderThickness="0,1,0,0"
                   Padding="20,16"
                   CornerRadius="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 快捷键提示 -->
                    <TextBlock Grid.Row="0" 
                              Text="⚙️ 快捷键：ESC 取消、Ctrl+S 保存"
                              FontSize="10"
                              Foreground="#6B7280"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"/>
                    
                    <!-- 按钮区域 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Content="取消 (ESC)"
                                Style="{StaticResource ButtonStyle}"
                                Background="{StaticResource MeidoThemeColorLight}"
                                Margin="0,0,12,0"
                                Height="36"
                                Click="CancelButton_Click"
                                ToolTip="取消编辑 (快捷键: ESC)"/>

                        <Button x:Name="SaveButton"
                                Content="💾 保存配置 (Ctrl+S)"
                                Style="{StaticResource ButtonStyle}"
                                Height="36"
                                Click="SaveButton_Click"
                                ToolTip="保存MCP服务器配置 (快捷键: Ctrl+S)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>