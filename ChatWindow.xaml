<Window x:Class="OpenMeido.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenMeido.Controls"
        Title="妹抖酱对话" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="{x:Null}">

    <!-- 主容器，带圆角 -->
    <Border Background="#FFF7F7"
            CornerRadius="18"
            BorderBrush="#E8C4C5"
            BorderThickness="1"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="24" ShadowDepth="6" Opacity="0.22"/>
        </Border.Effect>

        <Border Margin="1"
                Background="#FFFDFD"
                CornerRadius="17">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>  <!-- 自定义标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 工具栏 -->
                <RowDefinition Height="Auto"/> <!-- 历史记录面板 -->
                <RowDefinition Height="*"/>    <!-- 聊天区域 -->
                <RowDefinition Height="Auto"/> <!-- 输入区域 -->
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <controls:ChatTitleBarControl x:Name="TitleBarHost"
                                          Grid.Row="0"/>

            <!-- 工具栏 -->
            <controls:ChatToolbarControl x:Name="ToolbarHost"
                                         Grid.Row="1"/>

            <!-- 历史记录面板 -->
            <controls:ChatHistoryPanelControl x:Name="HistoryPanelHost"
                                              Grid.Row="2"
                                              Visibility="Collapsed"
                                              IsHitTestVisible="False"/>

            <!-- MCP状态面板 -->
            <controls:McpStatusPanelControl x:Name="McpStatusPanelHost"
                                            Grid.Row="2"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"/>

            <!-- 聊天消息区域 -->
            <controls:ChatMessageListControl x:Name="MessageListHost"
                                             Grid.Row="3"/>

            <!-- 底部输入区域 -->
            <controls:ChatInputPanelControl x:Name="InputPanelHost"
                                            Grid.Row="4"/>

        </Grid>
        </Border>
    </Border>
</Window>
